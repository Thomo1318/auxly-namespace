## ✅ EXAMPLE: COMPLETE AUTO-WORKFLOW

```typescript
// User: "Build chat feature"

// AI creates task
const task = await mcp_auxly_auxly_create_task({
  title: "Build real-time chat",
  priority: "high"
});

// AI asks question
console.log("🤖 I have a question about WebSocket implementation...");
await mcp_auxly_auxly_ask_question({
  taskId: task.id,
  questionText: "Which WebSocket library?",
  category: "TECHNICAL DECISION",
  options: [
    { label: "Socket.IO", recommended: true },
    { label: "ws library" }
  ]
});

console.log("⏳ Waiting for your answer... I'll check automatically every 5 seconds.");
console.log("💡 Just click your choice in the popup - no need to type here!");

// Auto-poll
let answer = null;
for (let i = 0; i < 60; i++) {
  await new Promise(r => setTimeout(r, 5000));
  
  const updatedTask = await mcp_auxly_auxly_get_task({ taskId: task.id });
  const lastQA = updatedTask.qaHistory?.[updatedTask.qaHistory.length - 1];
  
  if (lastQA?.answer) {
    answer = lastQA.answer.selectedOption;
    console.log(`✅ Answer received: "${answer}"`);
    break;
  }
  
  if (i % 6 === 0 && i > 0) {
    console.log(`⏳ Still waiting... (${i * 5}s elapsed)`);
  }
}

if (answer) {
  console.log(`🚀 Great! I'll use ${answer}. Starting implementation...`);
  // Continue automatically
  await implementWithSocketIO();
} else {
  console.log("⏱️ Timeout. Please type when ready!");
}
```

